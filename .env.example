# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key"

# Base URL for API calls
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Splitwise Integration
NEXT_PUBLIC_SPLITWISE_CLIENT_ID="your_splitwise_client_id"
SPLITWISE_CLIENT_SECRET="your_splitwise_client_secret"

# Local LLM Service (Ollama)
LOCAL_LLM_URL="http://raspi.dn:11434"

# Supabase (Optional / if using direct client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
